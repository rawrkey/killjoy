ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data,news

# LLM Provider (OpenAI-compatible — works with OmniRouter, Ollama, vLLM, etc.)
KILLJOY_LLM_API_KEY=your_llm_api_key_here
KILLJOY_LLM_BASE_URL=https://api.openai.com/v1
KILLJOY_LLM_MODEL=gpt-4o-mini
KILLJOY_LLM_TEMPERATURE=0.3
KILLJOY_LLM_MAX_TOKENS=2048

# Frontend: Set this to your deployed backend URL (e.g., Railway, Render)
# For Vercel deployment, set this as NEXT_PUBLIC_API_URL in Vercel env vars
NEXT_PUBLIC_API_URL=http://localhost:8000

# Control Secret: Protects live-cycle, autonomous toggle, and cron endpoints
# Set the SAME value in both backend env and frontend localStorage (killjoy_control_secret)
# Leave empty to disable auth (for local dev only)
KILLJOY_CONTROL_SECRET=
